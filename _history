e=\"variables_get\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"VAR\" id=\"G(AcGC(:O,kSbOMrFyhY\">heroSprite</field></block></value><value name=\"loc\"><shadow type=\"mapgettile\"><value name=\"col\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"row\"><shadow type=\"math_number\"><field name=\"NUM\">12</field></shadow></value></shadow><block type=\"mapgettile\" disabled-reasons=\"pxt_automatic_disabled\"><value name=\"col\"><shadow type=\"math_number\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"NUM\">2</field></shadow></value><value name=\"row\"><shadow type=\"math_number\"><field name=\"NUM\">12</field></shadow><block type=\"tiles.Location_blockCombine_get\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"property\">tiles.Location.column</field><value name=\"location\"><block type=\"tiles_location_of_sprite\" disabled-reasons=\"pxt_automatic_disabled\"><value name=\"this\"><block type=\"variables_get\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"VAR\" id=\"G(AcGC(:O,kSbOMrFyhY\">heroSprite</field></block></value></block></value></block></value></block></value></block></xml>","main.ts":"namespace SpriteKind {\n    export const Stone = SpriteKind.create()\n    export const Hint = SpriteKind.create()\n    export const Friend = SpriteKind.create()\n}\nfunction endGame (success: boolean) {\n    game.gameOver(success)\n}\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (currentScene == 0 && canTransitionScene) {\n        currentScene = 1\n        intro1()\n    } else if (currentScene == 1 && canTransitionScene) {\n        currentScene = 2\n        playGame()\n    } else if (currentScene == 2) {\n        checkStone()\n    } else if (currentScene == 3 && canTransitionScene) {\n        game.reset()\n    }\n})\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (currentScene == 2) {\n        jumpScare()\n    }\n})\nfunction checkShouldRun () {\n    for (let potentialCloseStoneIndex = 0; potentialCloseStoneIndex <= tiles.getTilesByType(assets.tile`StoneTileOne`).length - 1; potentialCloseStoneIndex++) {\n        // If a stone is close and we are above it, flee the friend.\n        if (tiles.getTilesByType(assets.tile`StoneTileOne`)[potentialCloseStoneIndex].x < heroSprite.x + 60 && tiles.getTilesByType(assets.tile`StoneTileOne`)[potentialCloseStoneIndex].x > heroSprite.x - 40 && heroSprite.z < tiles.getTilesByType(assets.tile`StoneTileOne`)[potentialCloseStoneIndex].y && (stonesData[potentialCloseStoneIndex] != \"none\" && stonesData[potentialCloseStoneIndex] != \"BOO\")) {\n            console.log(\"RUN AWAY! \" + stonesData[potentialCloseStoneIndex])\n            foundTenantIndex = tenantNames.indexOf(stonesData[potentialCloseStoneIndex])\n            tempSprite = sprites.create(tenantImages[foundTenantIndex], 0)\n            tempSprite.setPosition(tiles.getTilesByType(assets.tile`StoneTileOne`)[potentialCloseStoneIndex].x, tiles.getTilesByType(assets.tile`StoneTileOne`)[potentialCloseStoneIndex].y)\n            tempSprite.sayText(\"Ahh!\")\n            if (tempSprite.x < heroSprite.x) {\n                tempSprite.setVelocity(-200, 0)\n            } else {\n                tempSprite.setVelocity(200, 0)\n            }\n            availableTenants.push(stonesData[potentialCloseStoneIndex])\n            stonesData[potentialCloseStoneIndex] = \"none\"\n            assignTenants(potentialCloseStoneIndex)\n        }\n    }\n}\nfunction intro1 () {\n    canTransitionScene = false\n    scene.setBackgroundImage(img`.`)\n    tutorialText = fancyText.create(\"What started as a simple game of hide and seek...\")\n    fancyText.setMaxWidth(tutorialText, 140)\n    fancyText.setFont(tutorialText, fancyText.art_deco_11)\n    fancyText.setColor(tutorialText, 4)\n    tutorialText.setPosition(80, 60)\n    fancyText.animateAtSpeed(tutorialText, fancyText.TextSpeed.Fast, fancyText.AnimationPlayMode.UntilDone)\n    pause(1000)\n    sprites.destroy(tutorialText)\n    canTransitionScene = true\n}\nfunction moveHero () {\n    if (controller.right.isPressed()) {\n        potentialMoveHorizontal = walkingSpeed\n    } else if (controller.left.isPressed()) {\n        potentialMoveHorizontal = walkingSpeed * -1\n    } else {\n        potentialMoveHorizontal = 0\n    }\n    if (controller.up.isPressed()) {\n        potentialMoveVertical = walkingSpeed * -1\n    } else if (controller.down.isPressed()) {\n        potentialMoveVertical = walkingSpeed\n    } else {\n        potentialMoveVertical = 0\n    }\n    heroSprite.z = heroSprite.y\n    checkStoneBlocks()\n}\nfunction assignTenants (excludeIndex: number) {\n    console.log(\"Available tenants \" + availableTenants.length)\n    while (availableTenants.length > 0) {\n        tempProposedLocation = randint(0, stonesData.length)\n        if (stonesData[tempProposedLocation] == \"none\" && excludeIndex != tempProposedLocation) {\n            stonesData[tempProposedLocation] = availableTenants.removeAt(0)\n            console.log(\"At stone: \" + tempProposedLocation + \" \" + stonesData[tempProposedLocation])\n        }\n    }\n}\nfunction checkLoop () {\n    if (heroSprite.x > 1760) {\n        heroSprite.setPosition(160, heroSprite.y)\n    } else if (heroSprite.x < 160) {\n        heroSprite.setPosition(1760, heroSprite.y)\n    }\n}\nfunction checkStoneBlocks () {\n    for (let overlapPotential of sprites.allOfKind(SpriteKind.Stone)) {\n        // If overlapping fine, but check z-index to make sure they can't be at the bottom of the stone\n        if (heroSprite.overlapsWith(overlapPotential)) {\n            if (heroSprite.y > overlapPotential.y - 5 && heroSprite.y < overlapPotential.y + 5) {\n                // Aligned vertically, but attempting to move right/left/up/down\n                if (potentialMoveHorizontal < 0 && heroSprite.x > overlapPotential.x) {\n                    potentialMoveHorizontal = 0\n                } else if (potentialMoveHorizontal > 0 && heroSprite.x < overlapPotential.x) {\n                    potentialMoveHorizontal = 0\n                }\n            } else if (heroSprite.y > overlapPotential.y - 10 && heroSprite.y < overlapPotential.y + 5 && potentialMoveVertical > 0) {\n                potentialMoveVertical = 0\n            } else if (heroSprite.y < overlapPotential.y + 10 && heroSprite.y > overlapPotential.y - 5 && potentialMoveVertical < 0) {\n                potentialMoveVertical = 0\n            }\n        }\n    }\n    heroSprite.setVelocity(potentialMoveHorizontal, potentialMoveVertical)\n}\nfunction checkStone () {\n    for (let potentialOverlapStoneIndex = 0; potentialOverlapStoneIndex <= tiles.getTilesByType(assets.tile`StoneTileOne`).length - 1; potentialOverlapStoneIndex++) {\n        if (heroSprite.tilemapLocation().getNeighboringLocation(CollisionDirection.Top).column == tiles.getTilesByType(assets.tile`StoneTileOne`)[potentialOverlapStoneIndex].column && heroSprite.tilemapLocation().getNeighboringLocation(CollisionDirection.Top).row == tiles.getTilesByType(assets.tile`StoneTileOne`)[potentialOverlapStoneIndex].row && stonesData[potentialOverlapStoneIndex] != \"none\") {\n            console.log(stonesData[potentialOverlapStoneIndex])\n            if (stonesData[potentialOverlapStoneIndex] != \"BOO\") {\n                foundFriendIndex = tenantNames.indexOf(stonesData[potentialOverlapStoneIndex])\n                stonesData[potentialOverlapStoneIndex] = \"none\"\n                tempFriendSprite = sprites.create(tenantImages[foundFriendIndex], SpriteKind.Friend)\n                tempFriendSprite.setPosition(heroSprite.tilemapLocation().getNeighboringLocation(CollisionDirection.Top).column * 16, heroSprite.tilemapLocation().getNeighboringLocation(CollisionDirection.Top).row * 16)\n                tempFriendSprite.sayText(\"Found me!\", 1000, true)\n                setTimeout(() => {\n                    tempFriendSprite.setVelocity(-150, 0)\n    